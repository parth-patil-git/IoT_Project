FROM python:3.10-slim

WORKDIR /app

# Install system dependencies required for ML libraries and Matplotlib
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install required Python packages (add tensorflow or torch if the ML engine requires them)
RUN pip install --no-cache-dir paho-mqtt pandas matplotlib scikit-learn numpy

# Copy the prediction script
COPY pm25_prediction.py .

# Copy the cloned ML Engine repository
COPY CSC8112_MLEngine ./CSC8112_MLEngine

# The output directory will be mapped via docker-compose
CMD ["python", "-u", "pm25_prediction.py"]