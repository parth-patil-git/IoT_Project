FROM python:3.10-slim

WORKDIR /app

# Install system dependencies required for Prophet and Matplotlib
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install required Python packages including prophet
RUN pip install --no-cache-dir paho-mqtt pandas matplotlib numpy prophet

COPY pm25_prediction.py .
COPY CSC8112_MLEngine ./CSC8112_MLEngine

CMD ["python", "-u", "pm25_prediction.py"]