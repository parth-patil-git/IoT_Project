FROM python:3.10-slim

WORKDIR /app

# Install system dependencies required by OpenCV
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python libraries
RUN pip install --no-cache-dir ultralytics opencv-python-headless paho-mqtt numpy

COPY camera_inference.py .

# Pre-download YOLOv8n weights to avoid runtime downloads
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"

CMD ["python", "-u", "camera_inference.py"]